/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Variables de entorno: NINGUNA sube al repositorio.
# `.env*` cubre .env, .env.local, .env.production y cualquier variante.
.env*
# …salvo la PLANTILLA, que no lleva valores y documenta qué hay que
# configurar en Vercel y en cada máquina.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
